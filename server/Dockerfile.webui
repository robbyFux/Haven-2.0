FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for psycopg2-binary
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[web]"

# Allow all hosts by default; override via ALLOWED_HOSTS env var at runtime
ENV ALLOWED_HOSTS=*

COPY . .

WORKDIR /app/webui

# Build Tailwind CSS and collect static files
RUN python manage.py tailwind build
RUN python manage.py collectstatic --noinput

EXPOSE 8080

CMD ["sh", "-c", "python manage.py migrate --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:8080 --workers 2"]
